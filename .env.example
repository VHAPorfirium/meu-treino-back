# ===== Banco (Postgres) =====
# Local (docker-compose): use o host "localhost" quando rodar o seed/migrations da sua máquina
DATABASE_URL="postgresql://treino:treino@localhost:5432/meu_treino?schema=public"
# Em produção (Supabase): DATABASE_URL = pooler (porta 6543), DIRECT_URL = conexão direta (porta 5432)
DIRECT_URL="postgresql://treino:treino@localhost:5432/meu_treino?schema=public"

# ===== Auth =====
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="30d"
ADMIN_PIN="1234"
TRAINEE_PIN="5678"

# ===== API =====
PORT=3000
# Origem do frontend p/ CORS (Vercel em produção)
CORS_ORIGIN="http://localhost:3001"
# Cookie de sessão: false em local (http), true em produção (https + cross-site)
COOKIE_SECURE="false"

# ===== Seed: dataset =====
# Caminho da pasta do dataset clonado (relativo à raiz do backend)
DATASET_PATH="../exercises-dataset"

# ===== Seed: tradução pt-BR =====
# none = mantém inglês | libretranslate = usa endpoint LibreTranslate
TRANSLATION_PROVIDER="none"
LIBRETRANSLATE_URL="https://libretranslate.com/translate"
LIBRETRANSLATE_API_KEY=""

# ===== Seed: mídia (Supabase Storage) =====
# none = mantém caminhos relativos do dataset | supabase = faz upload e usa URL pública
MEDIA_PROVIDER="none"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="exercises"

# --- Frente G: cache em memória ---
# `false` desliga o cache inteiro sem redeploy de código (kill switch).
CACHE_ENABLED=true

# --- E9: fuso do "dia" das sessões de treino ---
# O servidor roda em UTC; isto é o fuso que define o que é "hoje" pra aluna.
APP_TIMEZONE=America/Sao_Paulo
