# ==========================================================================
# .env de PRODUÇÃO (Railway) — copie estes nomes como variáveis no Railway.
# NÃO comite valores reais. Este arquivo é só um modelo.
# ==========================================================================

# --- Banco (Supabase) ---
# DATABASE_URL = connection string do POOLER (Transaction, porta 6543) + pgbouncer=true
DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = connection string DIRETA (porta 5432) — usada por migrations / db push
DIRECT_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth / sessão ---
JWT_SECRET="<gere um segredo forte: openssl rand -hex 32>"
JWT_EXPIRES_IN="30d"
ADMIN_PIN="<troque>"
TRAINEE_PIN="<troque>"
# Em produção (https + front/back em domínios diferentes): SEMPRE true
COOKIE_SECURE="true"

# --- CORS: URL(s) do frontend na Vercel (separe por vírgula se tiver preview) ---
CORS_ORIGIN="https://SEU-APP.vercel.app"

# Railway injeta PORT automaticamente — não defina manualmente.

# --- Mídia (Supabase Storage) — usado no SEED p/ subir os GIFs ---
MEDIA_PROVIDER="supabase"
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role key do Supabase>"
SUPABASE_BUCKET="exercises"

# --- Tradução (opcional) ---
TRANSLATION_PROVIDER="none"

# --- Só p/ rodar o seed localmente (aponta pro dataset no seu PC) ---
DATASET_PATH="../exercises-dataset"
