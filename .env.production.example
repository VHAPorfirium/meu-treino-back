# ==========================================================================
# .env de PRODUÇÃO (VPS / Servidor Próprio)
# Copie para .env na raiz do projeto na sua VPS.
# NÃO comite valores reais. Este arquivo é só um modelo.
# ==========================================================================

PORT=3000
NODE_ENV=production

# --- Banco de Dados ---
# Opção 1: Postgres local rodando via Docker na própria VPS
# DATABASE_URL="postgresql://treino:SENHA_FORTE@db:5432/meu_treino?schema=public"
# DIRECT_URL="postgresql://treino:SENHA_FORTE@db:5432/meu_treino?schema=public"

# Opção 2: Supabase
# DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://treino:SENHA_FORTE@db:5432/meu_treino?schema=public"
DIRECT_URL="postgresql://treino:SENHA_FORTE@db:5432/meu_treino?schema=public"

# --- Auth / Sessão ---
JWT_SECRET="<gere um segredo forte: openssl rand -hex 32>"
JWT_EXPIRES_IN="30d"
ADMIN_PIN="9841"
VICTOR_PIN="5823"
NINFA_PIN="7194"
# Em produção (HTTPS ativo com proxy reverso): SEMPRE true
COOKIE_SECURE="true"
# Nginx/Caddy na VPS repassando requisições = 1
TRUST_PROXY_HOPS=1

# --- CORS: URL(s) do frontend (separe por vírgula se houver mais de uma) ---
CORS_ORIGIN="https://seu-front.vercel.app"

# --- Mídia (Supabase Storage) — usado no SEED p/ subir os GIFs ---
MEDIA_PROVIDER="supabase"
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role key do Supabase>"
SUPABASE_BUCKET="exercises"

# --- Tradução (opcional) ---
TRANSLATION_PROVIDER="none"

# --- Só p/ rodar o seed localmente (aponta pro dataset no seu PC) ---
DATASET_PATH="../exercises-dataset"
